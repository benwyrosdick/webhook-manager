# PostgreSQL connection string. Passwordless local URLs and ?sslmode=require both work.
DATABASE_URL=postgresql://username:password@localhost:5432/webhook_manager

# Required in production. Leave AUTH_PASSWORD empty in local development to skip the login prompt.
AUTH_USERNAME=admin
AUTH_PASSWORD=

# Optional. Leave unset so the UI uses the page origin for webhook URLs and API calls.
# VITE_API_BASE=http://localhost:3000
